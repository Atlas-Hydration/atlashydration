# Atlas Hydration — Environment Variables
# Copy this to .env and fill in your values

# Klaviyo Private API Key
# Get from: Klaviyo → Settings → API Keys → Create Private API Key
# Required scopes: templates:read, templates:write
KLAVIYO_API_KEY=pk_your_private_api_key_here

# Anthropic API Key (for Content Machine + Strategy Lab)
ANTHROPIC_API_KEY=sk-ant-your_key_here
